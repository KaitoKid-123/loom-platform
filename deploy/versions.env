# Mọi phiên bản pin ở một chỗ. Bump có chủ đích, không bao giờ dùng :latest.
K3S_IMAGE=rancher/k3s:v1.32.13-k3s1
K3D_VERSION=v5.9.0
TILT_VERSION=v0.37.6
DEX_IMAGE=ghcr.io/dexidp/dex:v2.45.1
ESO_VERSION=v2.8.0
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_K8S_VERSION=1.32.0

# Ba dòng dưới đây do CI đọc (.github/workflows/ci.yml nạp chính file này vào
# $GITHUB_ENV). scripts/bootstrap.sh KHÔNG cài helm/node/uv — nó chỉ đòi chúng
# có mặt — nên trên máy dev đây là ghi chép "CI dùng bản nào", còn trong CI thì
# là pin thật sự.
HELM_VERSION=v3.20.1
# NODE_VERSION và UV_VERSION còn bị viết lần thứ hai trong FROM của Dockerfile
# (một tag image không đọc được file env). `make check-pins` chặn hai bản đó
# lệch nhau — nếu không, CI test một toolchain khác với toolchain build image.
NODE_VERSION=22
UV_VERSION=0.11.21

# Lint cho workflow. shellcheck bắt buộc phải đi kèm actionlint: thiếu nó,
# actionlint lặng lẽ bỏ qua luật shellcheck và vẫn báo "0 errors".
ACTIONLINT_VERSION=v1.7.12
SHELLCHECK_VERSION=v0.10.0
