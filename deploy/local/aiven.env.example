# Copy thành aiven.env rồi điền từ console Aiven. File aiven.env bị gitignore.
# Tên khoá ở đây PHẢI khớp tên khoá Secret mà chart đang đọc (xem values.yaml).
username=avnadmin
password=
host=
port=
dbname=defaultdb

# Giai đoạn 2a: Lakekeeper giữ metadata catalog Iceberg trong một database RIÊNG
# trên CÙNG Aiven service (username/password/host/port dùng lại y hệt ở trên).
#
# Hệ quả phải nhớ: khôi phục Loom là khôi phục CẢ HAI database, về cùng một thời
# điểm. Khôi phục lệch nhau cho ra một hệ thống chạy được nhưng sai — xem
# docs/runbook/restore.md.
lakekeeper_dbname=lakekeeper
